{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "image": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string"
        },
        "tag": {
          "type": "string"
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "server": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "name"
      ]
    },
    "git": {
      "type": "object",
      "properties": {
        "repoUrl": {
          "type": "string"
        },
        "branch": {
          "type": "string",
          "minLength": 1
        },
        "syncIntervalSeconds": {
          "type": "integer",
          "minimum": 60
        },
        "skillsSubdir": {
          "type": "string",
          "description": "Optional subdirectory within the cloned repository to serve skills from. When set, SKILLS_DIR in the main container is /skills/<skillsSubdir>. Leave empty to serve from the repository root.",
          "default": ""
        },
        "patSecret": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "key": {
              "type": "string"
            }
          }
        },
        "caSecret": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "key": {
              "type": "string"
            }
          }
        }
      }
    },
    "webhook": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "hmacSecret": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "key": {
              "type": "string"
            }
          }
        },
        "ingress": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "className": {
              "type": "string"
            },
            "host": {
              "type": "string"
            },
            "annotations": {
              "type": "object"
            },
            "tls": {
              "type": "array"
            }
          }
        }
      }
    },
    "service": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "ClusterIP",
            "NodePort",
            "LoadBalancer"
          ]
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "nodeHeapSizeMb": {
      "type": "integer",
      "minimum": 64,
      "description": "Must be <= resources.limits.memory / 2. Caps the supergateway Node.js heap."
    },
    "resources": {
      "type": "object",
      "properties": {
        "requests": {
          "type": "object",
          "properties": {
            "cpu": {
              "type": "string"
            },
            "memory": {
              "type": "string"
            }
          }
        },
        "limits": {
          "type": "object",
          "properties": {
            "cpu": {
              "type": "string"
            },
            "memory": {
              "type": "string"
            }
          }
        }
      }
    },
    "kagent": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "namespace": {
          "type": "string",
          "minLength": 1
        },
        "serverName": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "timeout": {
          "type": "string"
        },
        "sseReadTimeout": {
          "type": "string"
        }
      }
    }
  }
}
